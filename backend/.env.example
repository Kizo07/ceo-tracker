# CEO Tracker Environment Variables

# Database
DATABASE_URL=postgresql://ceo_tracker:password@localhost:5432/ceo_tracker
POSTGRES_USER=ceo_tracker
POSTGRES_PASSWORD=password
POSTGRES_DB=ceo_tracker

# Redis
REDIS_URL=redis://localhost:6379/0

# API Keys
FINNHUB_API_KEY=your_finnhub_api_key_here

# Application
APP_NAME=CEO Tracker
APP_VERSION=0.1.0
DEBUG=True

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]

# NLP Settings
SPACY_MODEL=en_core_web_sm
FINBERT_MODEL=ProsusAI/finbert
