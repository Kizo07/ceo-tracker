    "/api/mentions": {
      "get": {
        "tags": [
          "mentions"
        ],
        "summary": "Get Mentions",
        "description": "Get paginated list of company mentions.\n\nFilters:\n- ceo_id: Filter by specific CEO\n- company_ticker: Filter by mentioned company ticker\n- sentiment: Filter by sentiment (positive/negative/neutral)",
